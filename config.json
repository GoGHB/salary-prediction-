{
    "data": {
        "raw_data_path": "data/raw/salary_data.csv",
        "processed_data_path": "data/processed/",
        "target_column": "salary",
        "categorical_columns": [
            "job_title",
            "company",
            "location",
            "education_level"
        ],
        "numerical_columns": [
            "years_of_experience",
            "age"
        ],
        "test_size": 0.2,
        "random_state": 42
    },
    "model": {
        "type": "random_forest",
        "params": {
            "n_estimators": 100,
            "max_depth": 10,
            "min_samples_split": 2,
            "min_samples_leaf": 1,
            "random_state": 42
        },
        "save_path": "models/salary_predictor.joblib"
    },
    "preprocessing": {
        "handle_missing": true,
        "remove_duplicates": true,
        "scale_features": true
    }
}
